{
  "name": "vidra",
  "private": true,
  "version": "0.2.0",
  "author": "Mathieu Mafille",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run && node --test \"scripts/**/*.node-test.mjs\"",
    "test:watch": "vitest",
    "check": "pnpm build && pnpm test && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked && pnpm test:corpus && pnpm release:check",
    "test:corpus": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib conversion_corpus -- --ignored --nocapture",
    "release:check": "node scripts/release/check-version.mjs",
    "ffmpeg:prepare": "node scripts/ffmpeg/prepare.mjs",
    "icon:prepare": "node scripts/icons/prepare-macos.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
