{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "updater:allow-check",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/mathieumaf/vidra" },
        { "url": "https://github.com/mathieumaf/vidra/releases/tag/v*" }
      ]
    }
  ]
}
