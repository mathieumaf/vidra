{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vidra",
  "mainBinaryName": "Vidra",
  "version": "0.1.0",
  "identifier": "io.github.mathieumaf.vidra",
  "build": {
    "beforeDevCommand": "pnpm icon:prepare && pnpm ffmpeg:prepare && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm icon:prepare && pnpm ffmpeg:prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vidra",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 650,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mathieumaf/vidra/releases/download/updater-manifest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3QTE0NzFFREJGRjczOEEKUldTS2MvL2JIa2VobHp1TnVLYTVpeGZtNFNiblIzM2VuU0ZYNlFFeTdNdy9QS05xcURKdU1UZ3gK"
    }
  }
}
